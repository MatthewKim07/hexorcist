{
  "assertions": [
    {
      "id": "a_period",
      "type": "serial_period",
      "pattern": "^RPM:",
      "period_ms": 1000,
      "tolerance_ms": 120,
      "description": "RPM: lines"
    },
    {
      "id": "a_val",
      "type": "serial_value_matches",
      "pattern": "RPM:(-?[0-9.]+)",
      "input_pin": "A5",
      "tolerance": 50,
      "max_lag_ms": 400,
      "description": "rpm value"
    }
  ],
  "scenarios": [
    {
      "id": "s_spin",
      "name": "1200 rpm",
      "seed": 1,
      "duration_ms": 5000,
      "analog": [
        {
          "pin": "A5",
          "segments": [
            {
              "t_ms": 0,
              "mv": 1200
            }
          ],
          "noise_mv": 10,
          "spikes": []
        }
      ],
      "digital": [],
      "floating": []
    }
  ]
}
