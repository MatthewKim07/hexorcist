{
  "assertions": [
    {
      "id": "a_period",
      "type": "serial_period",
      "pattern": "^flow: ",
      "period_ms": 500,
      "tolerance_ms": 120,
      "description": "2 Hz log"
    },
    {
      "id": "a_val",
      "type": "serial_value_matches",
      "pattern": "flow: (-?[0-9.]+)",
      "input_pin": "A0",
      "tolerance": 10,
      "max_lag_ms": 400,
      "description": "flow value"
    },
    {
      "id": "a_resp",
      "type": "responsive",
      "max_gap_ms": 900,
      "start_ms": 100,
      "description": "Responsive"
    }
  ],
  "scenarios": [
    {
      "id": "s_flow",
      "name": "Steady flow",
      "seed": 1,
      "duration_ms": 5000,
      "analog": [
        {
          "pin": "A0",
          "segments": [
            {
              "t_ms": 0,
              "mv": 300
            }
          ],
          "noise_mv": 5,
          "spikes": []
        }
      ],
      "digital": [],
      "floating": []
    }
  ]
}
