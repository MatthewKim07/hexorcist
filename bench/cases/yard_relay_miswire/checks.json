{
  "assertions": [
    {
      "id": "a_follow",
      "type": "output_follows",
      "pin": "D8",
      "high_when": {
        "pin": "A0",
        "op": "<",
        "value": 400
      },
      "low_when": {
        "pin": "A0",
        "op": ">",
        "value": 600
      },
      "within_ms": 400,
      "description": "Relay follows light",
      "covers": "Relay D8 ON when light reading is below 400 units; OFF when above 600 units"
    },
    {
      "id": "a_status",
      "type": "serial_period",
      "pattern": "^yard u=",
      "period_ms": 1000,
      "tolerance_ms": 120,
      "description": "Yard status",
      "covers": "Print `yard u=<n> relay=ON` or `yard u=<n> relay=OFF` every 1000 ms"
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_dark",
      "name": "Dark",
      "seed": 1,
      "duration_ms": 4000,
      "analog": [
        {
          "pin": "A0",
          "segments": [
            {
              "t_ms": 0,
              "mv": 200
            }
          ],
          "noise_mv": 5,
          "spikes": []
        }
      ],
      "digital": [
        {
          "pin": "D3",
          "initial": 1,
          "events": []
        }
      ],
      "floating": []
    },
    {
      "id": "s_bright",
      "name": "Bright",
      "seed": 2,
      "duration_ms": 4000,
      "analog": [
        {
          "pin": "A0",
          "segments": [
            {
              "t_ms": 0,
              "mv": 800
            }
          ],
          "noise_mv": 5,
          "spikes": []
        }
      ],
      "digital": [
        {
          "pin": "D3",
          "initial": 1,
          "events": []
        }
      ],
      "floating": []
    }
  ]
}
