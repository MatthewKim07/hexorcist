{
  "assertions": [
    {
      "id": "a_period",
      "type": "serial_period",
      "pattern": "^kPa: ",
      "period_ms": 1000,
      "tolerance_ms": 120,
      "description": "One kPa line per second",
      "covers": "Emit `kPa: <value>` once every 1000 ms"
    },
    {
      "id": "a_val",
      "type": "serial_value_matches",
      "pattern": "kPa: (-?[0-9.]+)",
      "input_pin": "A2",
      "tolerance": 2.0,
      "max_lag_ms": 400,
      "description": "Printed kPa matches transducer",
      "covers": "Printed pressure must match the injected value within ±2.0 kPa"
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_100",
      "name": "Steady 100 kPa",
      "seed": 1,
      "duration_ms": 5000,
      "analog": [
        {
          "pin": "A2",
          "segments": [
            {
              "t_ms": 0,
              "mv": 1500
            }
          ],
          "noise_mv": 4,
          "spikes": []
        }
      ],
      "digital": [],
      "floating": []
    }
  ]
}
