{
  "assertions": [
    {
      "id": "a_period",
      "type": "serial_period",
      "pattern": "^tick$",
      "period_ms": 1000,
      "tolerance_ms": 120,
      "description": "Rising edge every 1 s",
      "covers": "Print the exact line `tick` on each rising edge of the beacon (once per 1000 ms \u00b1120 ms)"
    },
    {
      "id": "a_max",
      "type": "max_toggles",
      "pin": "D12",
      "max_toggles": 5,
      "window_ms": 2000,
      "description": "Blink rate cap",
      "covers": "Beacon must not change state more than 5 times in any 2000 ms window"
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_blink",
      "name": "Free blink",
      "seed": 1,
      "duration_ms": 6000,
      "analog": [],
      "floating": [],
      "digital": [
        {
          "pin": "D3",
          "initial": 1,
          "events": []
        }
      ]
    }
  ]
}
