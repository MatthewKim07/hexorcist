{
  "assertions": [
    {
      "id": "a_pulse",
      "type": "timed_pulse",
      "pin": "D7",
      "trigger": {
        "pin": "D4",
        "op": "==",
        "value": 0
      },
      "duration_ms": 2500,
      "within_ms": 150,
      "during_pulse": "ignore",
      "min_trigger_ms": 40,
      "description": "2.5 s siren pulse",
      "covers": "A settled press as short as 40 ms starts a 2500 ms HIGH pulse on D7 within 150 ms"
    },
    {
      "id": "a_hb",
      "type": "serial_period",
      "pattern": "^hb$",
      "period_ms": 400,
      "tolerance_ms": 80,
      "description": "Heartbeat",
      "covers": "Print the exact line `hb` every 400 ms at all times"
    },
    {
      "id": "a_resp",
      "type": "responsive",
      "max_gap_ms": 700,
      "start_ms": 100,
      "description": "Stay responsive",
      "covers": "Never remain silent (no serial and no output change) for more than 700 ms"
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_rapid",
      "name": "Rapid panic presses",
      "seed": 5,
      "duration_ms": 9000,
      "analog": [],
      "floating": [],
      "digital": [
        {
          "pin": "D4",
          "initial": 1,
          "events": [
            {
              "t_ms": 300,
              "value": 0,
              "bounce_ms": 0,
              "bounce_count": 0
            },
            {
              "t_ms": 500,
              "value": 1,
              "bounce_ms": 0,
              "bounce_count": 0
            },
            {
              "t_ms": 900,
              "value": 0,
              "bounce_ms": 0,
              "bounce_count": 0
            },
            {
              "t_ms": 1100,
              "value": 1,
              "bounce_ms": 0,
              "bounce_count": 0
            },
            {
              "t_ms": 3200,
              "value": 0,
              "bounce_ms": 0,
              "bounce_count": 0
            },
            {
              "t_ms": 3400,
              "value": 1,
              "bounce_ms": 0,
              "bounce_count": 0
            }
          ]
        }
      ]
    }
  ]
}
