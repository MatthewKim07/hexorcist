{
  "assertions": [
    {
      "id": "a_follow",
      "type": "output_follows",
      "pin": "D6",
      "high_when": {
        "pin": "A0",
        "op": ">=",
        "value": 30
      },
      "low_when": {
        "pin": "A0",
        "op": "<=",
        "value": 26
      },
      "within_ms": 500,
      "description": "Fan follows 30/26 C band",
      "covers": "Open the fan at 30.0 °C or above; close the fan at 26.0 °C or below"
    },
    {
      "id": "a_chatter",
      "type": "max_toggles",
      "pin": "D6",
      "max_toggles": 2,
      "window_ms": 5000,
      "description": "Switching limit",
      "covers": "Fan must not change state more than 2 times in any 5000 ms window"
    },
    {
      "id": "a_fault",
      "type": "safe_state_on_fault",
      "fault_when": {
        "pin": "A0",
        "op": "<",
        "value": 5
      },
      "output_pin": "D6",
      "safe_value": 1,
      "within_ms": 600,
      "description": "Underrange forces fan ON",
      "covers": "If the probe is floating, or temperature reads below 5.0 °C or above 100.0 °C, force the fan ON within 600 ms"
    },
    {
      "id": "a_status",
      "type": "serial_period",
      "pattern": "^shed: ",
      "period_ms": 1000,
      "tolerance_ms": 120,
      "description": "Shed status line",
      "covers": "Print `shed: <temp> C fan=ON` or `shed: <temp> C fan=OFF` every 1000 ms"
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_hover",
      "name": "Hover 30 C noise",
      "seed": 3,
      "duration_ms": 8000,
      "analog": [
        {
          "pin": "A0",
          "segments": [
            {
              "t_ms": 0,
              "mv": 300
            }
          ],
          "noise_mv": 18,
          "spikes": []
        }
      ],
      "digital": [],
      "floating": []
    },
    {
      "id": "s_underrange",
      "name": "Cool then underrange",
      "seed": 4,
      "duration_ms": 9000,
      "analog": [
        {
          "pin": "A0",
          "segments": [
            {
              "t_ms": 0,
              "mv": 180
            },
            {
              "t_ms": 2500,
              "mv": 0
            }
          ],
          "noise_mv": 2,
          "spikes": []
        }
      ],
      "digital": [],
      "floating": []
    },
    {
      "id": "s_hot",
      "name": "Steady 38 C",
      "seed": 1,
      "duration_ms": 4000,
      "analog": [
        {
          "pin": "A0",
          "segments": [
            {
              "t_ms": 0,
              "mv": 380
            }
          ],
          "noise_mv": 3,
          "spikes": []
        }
      ],
      "digital": [],
      "floating": []
    }
  ]
}
