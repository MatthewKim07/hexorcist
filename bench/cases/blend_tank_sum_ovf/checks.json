{
  "assertions": [
    {
      "id": "a_period",
      "type": "serial_period",
      "pattern": "^pct: ",
      "period_ms": 1000,
      "tolerance_ms": 200,
      "description": "1 Hz pct lines",
      "covers": "Lines matching `pct: ` must appear every 1000 ms \u00b1150 ms"
    },
    {
      "id": "a_val",
      "type": "serial_value_matches",
      "pattern": "pct: (-?[0-9.]+)",
      "input_pin": "A4",
      "tolerance": 3.0,
      "max_lag_ms": 500,
      "description": "percent correct",
      "covers": "Printed percent must stay within \u00b13.0 of the injected probe value"
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_hi",
      "name": "High concentration",
      "seed": 1,
      "duration_ms": 5000,
      "analog": [
        {
          "pin": "A4",
          "segments": [
            {
              "t_ms": 0,
              "mv": 4200
            }
          ],
          "noise_mv": 5,
          "spikes": []
        }
      ],
      "digital": [
        {
          "pin": "D5",
          "initial": 1,
          "events": []
        }
      ],
      "floating": []
    }
  ]
}
