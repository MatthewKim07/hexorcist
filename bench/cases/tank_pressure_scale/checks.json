{
  "assertions": [
    {
      "id": "a_period",
      "type": "serial_period",
      "pattern": "^kPa: ",
      "period_ms": 1000,
      "tolerance_ms": 120,
      "description": "1 Hz log"
    },
    {
      "id": "a_val",
      "type": "serial_value_matches",
      "pattern": "kPa: (-?[0-9.]+)",
      "input_pin": "A3",
      "tolerance": 2.0,
      "max_lag_ms": 400,
      "description": "kPa matches transducer"
    }
  ],
  "scenarios": [
    {
      "id": "s_100",
      "name": "100 kPa",
      "seed": 4,
      "duration_ms": 5000,
      "analog": [
        {
          "pin": "A3",
          "segments": [
            {
              "t_ms": 0,
              "mv": 400
            }
          ],
          "noise_mv": 2,
          "spikes": []
        }
      ],
      "digital": [],
      "floating": []
    }
  ]
}
