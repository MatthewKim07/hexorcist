{
  "assertions": [
    {
      "id": "a_period",
      "type": "serial_period",
      "pattern": "^Temp: ",
      "period_ms": 1000,
      "tolerance_ms": 120,
      "description": "Temp: lines",
      "covers": "Every 1000 ms print exactly `Temp: <celsius>` with a space after the colon and one decimal place"
    },
    {
      "id": "a_val",
      "type": "serial_value_matches",
      "pattern": "Temp: (-?[0-9.]+)",
      "input_pin": "A0",
      "tolerance": 1.5,
      "max_lag_ms": 400,
      "description": "Value OK",
      "covers": "Printed temperature must stay within \u00b11.5 \u00b0C of the injected probe value"
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_room",
      "name": "Room temp",
      "seed": 1,
      "duration_ms": 5000,
      "analog": [
        {
          "pin": "A0",
          "segments": [
            {
              "t_ms": 0,
              "mv": 750
            }
          ],
          "noise_mv": 5,
          "spikes": []
        }
      ],
      "digital": [
        {
          "pin": "D5",
          "initial": 1,
          "events": []
        }
      ],
      "floating": []
    }
  ]
}
