{
  "assertions": [
    {
      "id": "a_follow",
      "type": "output_follows",
      "pin": "D5",
      "low_when": {
        "pin": "D3",
        "op": "==",
        "value": 0
      },
      "high_when": {
        "pin": "D3",
        "op": "==",
        "value": 1
      },
      "within_ms": 100,
      "description": "Contactor follows e-stop",
      "covers": "Contactor D5 must drop LOW when e-stop is held (D3 LOW), and run HIGH when e-stop is released"
    },
    {
      "id": "a_beat",
      "type": "serial_period",
      "pattern": "^hoist run=",
      "period_ms": 1100,
      "tolerance_ms": 150,
      "description": "Hoist heartbeat",
      "covers": "Print `hoist run=<0|1> trips=<n>` every 1100 ms"
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_stop",
      "name": "E-stop hold",
      "seed": 3,
      "duration_ms": 4000,
      "analog": [],
      "floating": [],
      "digital": [
        {
          "pin": "D3",
          "initial": 1,
          "events": [
            {
              "t_ms": 500,
              "value": 0,
              "bounce_ms": 0,
              "bounce_count": 0
            },
            {
              "t_ms": 3000,
              "value": 1,
              "bounce_ms": 0,
              "bounce_count": 0
            }
          ]
        },
        {
          "pin": "D6",
          "initial": 1,
          "events": []
        }
      ]
    }
  ]
}
