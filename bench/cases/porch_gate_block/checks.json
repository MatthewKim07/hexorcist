{
  "assertions": [
    {
      "id": "a_pulse",
      "type": "timed_pulse",
      "pin": "D10",
      "trigger": {
        "pin": "D3",
        "op": "==",
        "value": 0
      },
      "duration_ms": 1800,
      "within_ms": 150,
      "during_pulse": "ignore",
      "min_trigger_ms": 40,
      "description": "1.8 s chime on gate open",
      "covers": "A settled open event as short as 40 ms starts an 1800 ms HIGH pulse on D10 within 150 ms"
    },
    {
      "id": "a_hb",
      "type": "serial_period",
      "pattern": "^gate-hb$",
      "period_ms": 300,
      "tolerance_ms": 80,
      "description": "Gate heartbeat",
      "covers": "Print the exact line `gate-hb` every 300 ms continuously"
    },
    {
      "id": "a_resp",
      "type": "responsive",
      "max_gap_ms": 700,
      "start_ms": 100,
      "description": "Stay responsive",
      "covers": "Never remain silent (no serial and no output change) for more than 700 ms"
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_rapid",
      "name": "Rapid gate opens",
      "seed": 6,
      "duration_ms": 8000,
      "analog": [],
      "floating": [],
      "digital": [
        {
          "pin": "D3",
          "initial": 1,
          "events": [
            {
              "t_ms": 250,
              "value": 0,
              "bounce_ms": 0,
              "bounce_count": 0
            },
            {
              "t_ms": 450,
              "value": 1,
              "bounce_ms": 0,
              "bounce_count": 0
            },
            {
              "t_ms": 700,
              "value": 0,
              "bounce_ms": 0,
              "bounce_count": 0
            },
            {
              "t_ms": 900,
              "value": 1,
              "bounce_ms": 0,
              "bounce_count": 0
            },
            {
              "t_ms": 2400,
              "value": 0,
              "bounce_ms": 0,
              "bounce_count": 0
            },
            {
              "t_ms": 2600,
              "value": 1,
              "bounce_ms": 0,
              "bounce_count": 0
            }
          ]
        }
      ]
    }
  ]
}
