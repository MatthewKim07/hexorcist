{
  "assertions": [
    {
      "id": "a_pulse",
      "type": "timed_pulse",
      "pin": "D8",
      "trigger": {
        "pin": "D2",
        "op": "==",
        "value": 0
      },
      "duration_ms": 2000,
      "within_ms": 150,
      "during_pulse": "ignore",
      "min_trigger_ms": 40,
      "description": "2 s siren on door open",
      "covers": "A settled door-open press as short as 40 ms starts a 2000 ms HIGH pulse on D8 within 150 ms"
    },
    {
      "id": "a_hb",
      "type": "serial_period",
      "pattern": "^hb$",
      "period_ms": 250,
      "tolerance_ms": 80,
      "description": "Heartbeat every 250 ms",
      "covers": "Print the exact line `hb` every 250 ms at all times"
    },
    {
      "id": "a_resp",
      "type": "responsive",
      "max_gap_ms": 700,
      "start_ms": 100,
      "description": "Must stay responsive",
      "covers": "Firmware must never go silent (no serial and no pin change) for more than 700 ms"
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_rapid",
      "name": "Rapid door opens during siren",
      "seed": 5,
      "duration_ms": 8000,
      "analog": [],
      "floating": [],
      "digital": [
        {
          "pin": "D2",
          "initial": 1,
          "events": [
            {
              "t_ms": 300,
              "value": 0,
              "bounce_ms": 0,
              "bounce_count": 0
            },
            {
              "t_ms": 500,
              "value": 1,
              "bounce_ms": 0,
              "bounce_count": 0
            },
            {
              "t_ms": 800,
              "value": 0,
              "bounce_ms": 0,
              "bounce_count": 0
            },
            {
              "t_ms": 1000,
              "value": 1,
              "bounce_ms": 0,
              "bounce_count": 0
            },
            {
              "t_ms": 2500,
              "value": 0,
              "bounce_ms": 0,
              "bounce_count": 0
            },
            {
              "t_ms": 2700,
              "value": 1,
              "bounce_ms": 0,
              "bounce_count": 0
            }
          ]
        }
      ]
    }
  ]
}
