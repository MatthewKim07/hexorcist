{
  "assertions": [
    {
      "id": "a_follow",
      "type": "output_follows",
      "pin": "D13",
      "high_when": {
        "pin": "D2",
        "op": "==",
        "value": 0
      },
      "low_when": {
        "pin": "D2",
        "op": "==",
        "value": 1
      },
      "within_ms": 100,
      "description": "D13 follows button",
      "covers": "While D2 is pressed and D4 is released, light D13 HIGH; release turns D13 LOW"
    },
    {
      "id": "a_status",
      "type": "serial_period",
      "pattern": "^bench led=",
      "period_ms": 1000,
      "tolerance_ms": 120,
      "description": "Bench status",
      "covers": "Print `bench led=<0|1> held_ms=<n>` every 1000 ms"
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_press",
      "name": "Press",
      "seed": 1,
      "duration_ms": 4000,
      "analog": [],
      "floating": [],
      "digital": [
        {
          "pin": "D2",
          "initial": 1,
          "events": [
            {
              "t_ms": 500,
              "value": 0,
              "bounce_ms": 0,
              "bounce_count": 0
            },
            {
              "t_ms": 2000,
              "value": 1,
              "bounce_ms": 0,
              "bounce_count": 0
            }
          ]
        },
        {
          "pin": "D4",
          "initial": 1,
          "events": []
        }
      ]
    }
  ]
}
