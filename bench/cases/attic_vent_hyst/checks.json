{
  "assertions": [
    {
      "id": "a_follow",
      "type": "output_follows",
      "pin": "D8",
      "high_when": {
        "pin": "A0",
        "op": ">=",
        "value": 42
      },
      "low_when": {
        "pin": "A0",
        "op": "<=",
        "value": 38
      },
      "within_ms": 500,
      "description": "Fan follows 42/38 C band",
      "covers": "Turn the vent fan ON when attic temperature reaches 42.0 °C or above, and turn it OFF when temperature falls to 38.0 °C or below"
    },
    {
      "id": "a_chatter",
      "type": "max_toggles",
      "pin": "D8",
      "max_toggles": 2,
      "window_ms": 5000,
      "description": "Fan switching limit",
      "covers": "Fan must not change state more than 2 times in any 5000 ms window"
    },
    {
      "id": "a_status",
      "type": "serial_period",
      "pattern": "^attic: ",
      "period_ms": 1000,
      "tolerance_ms": 120,
      "description": "Status every second",
      "covers": "Print one status line every 1000 ms in the form"
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_hover",
      "name": "Hover at 42 C with noise",
      "seed": 3,
      "duration_ms": 8000,
      "analog": [
        {
          "pin": "A0",
          "segments": [
            {
              "t_ms": 0,
              "mv": 420
            }
          ],
          "noise_mv": 20,
          "spikes": []
        }
      ],
      "digital": [
        {
          "pin": "D3",
          "initial": 1,
          "events": []
        }
      ],
      "floating": []
    },
    {
      "id": "s_hot",
      "name": "Steady hot 48 C",
      "seed": 1,
      "duration_ms": 4000,
      "analog": [
        {
          "pin": "A0",
          "segments": [
            {
              "t_ms": 0,
              "mv": 480
            }
          ],
          "noise_mv": 4,
          "spikes": []
        }
      ],
      "digital": [
        {
          "pin": "D3",
          "initial": 1,
          "events": []
        }
      ],
      "floating": []
    }
  ]
}
