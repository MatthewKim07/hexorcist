{
  "assertions": [
    {
      "id": "a_unlock",
      "type": "output_follows",
      "pin": "D9",
      "low_when": {
        "pin": "D3",
        "op": "==",
        "value": 1
      },
      "within_ms": 200,
      "description": "Unlocked when door open",
      "covers": "Unlock (D9 LOW) when the door opens (D3 HIGH); unlock within 200 ms of door open"
    },
    {
      "id": "a_status",
      "type": "serial_period",
      "pattern": "^vault lock=",
      "period_ms": 1000,
      "tolerance_ms": 120,
      "description": "Vault status",
      "covers": "Print `vault lock=<0|1> engages=<n>` every 1000 ms"
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
