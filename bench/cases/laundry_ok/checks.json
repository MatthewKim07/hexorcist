{
  "assertions": [
    {
      "id": "a_motor",
      "type": "output_follows",
      "pin": "D10",
      "low_when": {
        "pin": "A0",
        "op": "<",
        "value": 20
      },
      "within_ms": 600,
      "description": "Motor off below 20 cm",
      "covers": "Leave RUN and return to IDLE when level drops below 20.0 cm; motor D10 must go LOW within 600 ms"
    },
    {
      "id": "a_status",
      "type": "serial_period",
      "pattern": "^laundry st=",
      "period_ms": 1000,
      "tolerance_ms": 120,
      "description": "Laundry status",
      "covers": "Print `laundry st=<0|1|2> cm=<n>` every 1000 ms"
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_cycle",
      "name": "Fill then drain",
      "seed": 7,
      "duration_ms": 10000,
      "analog": [
        {
          "pin": "A0",
          "segments": [
            {
              "t_ms": 0,
              "mv": 50
            },
            {
              "t_ms": 1500,
              "mv": 280
            },
            {
              "t_ms": 4000,
              "mv": 280
            },
            {
              "t_ms": 5500,
              "mv": 100
            }
          ],
          "noise_mv": 5,
          "spikes": []
        }
      ],
      "digital": [
        {
          "pin": "D4",
          "initial": 1,
          "events": []
        }
      ],
      "floating": []
    }
  ]
}
