{
  "assertions": [
    {
      "id": "a_follow",
      "type": "output_follows",
      "pin": "D9",
      "high_when": {
        "pin": "A2",
        "op": ">=",
        "value": 28
      },
      "low_when": {
        "pin": "A2",
        "op": "<=",
        "value": 24
      },
      "within_ms": 500,
      "description": "Fan follows 28/24 C band",
      "covers": "Open the fan when temperature reaches 28.0 °C or above; close the fan when temperature falls to 24.0 °C or below"
    },
    {
      "id": "a_chatter",
      "type": "max_toggles",
      "pin": "D9",
      "max_toggles": 2,
      "window_ms": 5000,
      "description": "Switching limit",
      "covers": "Fan must not change state more than 2 times in any 5000 ms window"
    },
    {
      "id": "a_fault",
      "type": "safe_state_on_fault",
      "floating_pin": "A2",
      "output_pin": "D9",
      "safe_value": 1,
      "within_ms": 600,
      "description": "Float forces fan ON",
      "covers": "If the probe is floating, or temperature reads below 0.0 °C or above 100.0 °C, force the fan ON within 600 ms"
    },
    {
      "id": "a_status",
      "type": "serial_period",
      "pattern": "^gh: ",
      "period_ms": 1000,
      "tolerance_ms": 120,
      "description": "Greenhouse status line",
      "covers": "Print `gh: <temp> C fan=ON` or `gh: <temp> C fan=OFF` every 1000 ms"
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_hover",
      "name": "Hover 28 C noise",
      "seed": 3,
      "duration_ms": 8000,
      "analog": [
        {
          "pin": "A2",
          "segments": [
            {
              "t_ms": 0,
              "mv": 280
            }
          ],
          "noise_mv": 20,
          "spikes": []
        }
      ],
      "digital": [],
      "floating": []
    },
    {
      "id": "s_float",
      "name": "Cool then float",
      "seed": 4,
      "duration_ms": 9000,
      "analog": [
        {
          "pin": "A2",
          "segments": [
            {
              "t_ms": 0,
              "mv": 200
            }
          ],
          "noise_mv": 2,
          "spikes": []
        }
      ],
      "digital": [],
      "floating": [
        {
          "pin": "A2",
          "from_ms": 2500,
          "to_ms": 8500
        }
      ]
    },
    {
      "id": "s_hot",
      "name": "Steady 34 C",
      "seed": 1,
      "duration_ms": 4000,
      "analog": [
        {
          "pin": "A2",
          "segments": [
            {
              "t_ms": 0,
              "mv": 340
            }
          ],
          "noise_mv": 3,
          "spikes": []
        }
      ],
      "digital": [],
      "floating": []
    }
  ]
}
