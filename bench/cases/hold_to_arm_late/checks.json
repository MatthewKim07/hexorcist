{
  "assertions": [
    {
      "id": "a_follow",
      "type": "output_follows",
      "pin": "D8",
      "high_when": {
        "pin": "D3",
        "op": "==",
        "value": 0
      },
      "low_when": {
        "pin": "D3",
        "op": "==",
        "value": 1
      },
      "within_ms": 550,
      "description": "Armed after ~500 ms hold",
      "covers": "After a qualifying hold, D8 must be HIGH within 550 ms of the press start"
    },
    {
      "id": "a_status",
      "type": "serial_period",
      "pattern": "^arm lit=",
      "period_ms": 1000,
      "tolerance_ms": 120,
      "description": "Arm status",
      "covers": "Print `arm lit=<0|1> events=<n>` every 1000 ms"
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_hold",
      "name": "Hold 520 ms",
      "seed": 1,
      "duration_ms": 4000,
      "analog": [],
      "floating": [],
      "digital": [
        {
          "pin": "D3",
          "initial": 1,
          "events": [
            {
              "t_ms": 300,
              "value": 0,
              "bounce_ms": 0,
              "bounce_count": 0
            },
            {
              "t_ms": 820,
              "value": 1,
              "bounce_ms": 0,
              "bounce_count": 0
            }
          ]
        },
        {
          "pin": "D5",
          "initial": 1,
          "events": []
        }
      ]
    }
  ]
}
