{
  "assertions": [
    {
      "id": "a_tpp",
      "type": "toggle_per_press",
      "input_pin": "D3",
      "output_pin": "D12",
      "active_level": 0,
      "settle_ms": 45,
      "within_ms": 150,
      "description": "One toggle per settled press",
      "covers": "Each settled press toggles the lamp exactly once within 150 ms"
    },
    {
      "id": "a_status",
      "type": "serial_period",
      "pattern": "^lobby lamp=",
      "period_ms": 1400,
      "tolerance_ms": 150,
      "description": "Lobby status line",
      "covers": "Print `lobby lamp=ON n=<count>` or `lobby lamp=OFF n=<count>` every 1400 ms"
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
