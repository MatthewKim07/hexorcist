{
  "assertions": [
    {
      "id": "a_period",
      "type": "serial_period",
      "pattern": "^RPM:",
      "period_ms": 1000,
      "tolerance_ms": 120,
      "description": "RPM: lines",
      "covers": "Print `RPM:<n>` with no space after the colon once per second (1000 ms \u00b1120 ms)"
    },
    {
      "id": "a_val",
      "type": "serial_value_matches",
      "pattern": "RPM:(-?[0-9.]+)",
      "input_pin": "A5",
      "tolerance": 50,
      "max_lag_ms": 400,
      "description": "rpm value",
      "covers": "Printed rpm must stay within \u00b150 of the injected tach value"
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_spin",
      "name": "1200 rpm",
      "seed": 1,
      "duration_ms": 5000,
      "analog": [
        {
          "pin": "A5",
          "segments": [
            {
              "t_ms": 0,
              "mv": 1200
            }
          ],
          "noise_mv": 10,
          "spikes": []
        }
      ],
      "digital": [
        {
          "pin": "D3",
          "initial": 1,
          "events": []
        }
      ],
      "floating": []
    }
  ]
}
