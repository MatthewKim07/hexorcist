{
  "assertions": [
    {
      "id": "a_follow",
      "type": "output_follows",
      "pin": "D9",
      "high_when": {
        "pin": "A0",
        "op": "<",
        "value": 18
      },
      "low_when": {
        "pin": "A0",
        "op": ">",
        "value": 22
      },
      "within_ms": 600,
      "description": "Heat below 18, off above 22",
      "covers": "Turn the heater ON when temperature is below 18.0 \u00b0C and OFF when temperature is above 22.0 \u00b0C"
    },
    {
      "id": "a_status",
      "type": "serial_period",
      "pattern": "^cabin: ",
      "period_ms": 1000,
      "tolerance_ms": 120,
      "description": "Cabin status",
      "covers": "Print `cabin: <temp> C heat=ON` or `cabin: <temp> C heat=OFF` every 1000 ms"
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_cold",
      "name": "Cold 10 C",
      "seed": 1,
      "duration_ms": 4000,
      "analog": [
        {
          "pin": "A0",
          "segments": [
            {
              "t_ms": 0,
              "mv": 100
            }
          ],
          "noise_mv": 2,
          "spikes": []
        }
      ],
      "digital": [
        {
          "pin": "D2",
          "initial": 1,
          "events": []
        }
      ],
      "floating": []
    },
    {
      "id": "s_hot",
      "name": "Hot 30 C",
      "seed": 2,
      "duration_ms": 4000,
      "analog": [
        {
          "pin": "A0",
          "segments": [
            {
              "t_ms": 0,
              "mv": 300
            }
          ],
          "noise_mv": 2,
          "spikes": []
        }
      ],
      "digital": [
        {
          "pin": "D2",
          "initial": 1,
          "events": []
        }
      ],
      "floating": []
    }
  ]
}
