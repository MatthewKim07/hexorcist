{
  "assertions": [
    {
      "id": "a_burst",
      "type": "timed_pulse",
      "pin": "D10",
      "trigger": {"pin": "D6", "op": "==", "value": 0},
      "duration_ms": 500,
      "tolerance_ms": 80,
      "within_ms": 100,
      "min_trigger_ms": 30,
      "active_level": 1,
      "during_pulse": "ignore",
      "description": "A press opens the valve for 500 ms",
      "covers": "A settled press on D6 opens the valve (D10 HIGH) for 500 ms, starting within 100 ms of the press."
    },
    {
      "id": "a_status",
      "type": "serial_period",
      "pattern": "^zone n=\\d+$",
      "period_ms": 1000,
      "tolerance_ms": 150,
      "description": "Status line once per second",
      "covers": "Print `zone n=<count>` every 1000 ms."
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_single",
      "name": "One press after power-on",
      "seed": 1,
      "duration_ms": 5000,
      "digital": [
        {"pin": "D6", "initial": 1, "events": [
          {"t_ms": 1000, "value": 0},
          {"t_ms": 1150, "value": 1}
        ]}
      ]
    },
    {
      "id": "s_bounce",
      "name": "Presses with contact bounce",
      "seed": 2,
      "duration_ms": 6000,
      "digital": [
        {"pin": "D6", "initial": 1, "events": [
          {"t_ms": 1000, "value": 0, "bounce_ms": 10, "bounce_count": 4},
          {"t_ms": 1200, "value": 1, "bounce_ms": 10, "bounce_count": 4},
          {"t_ms": 2600, "value": 0, "bounce_ms": 11, "bounce_count": 3},
          {"t_ms": 2800, "value": 1, "bounce_ms": 11, "bounce_count": 3}
        ]}
      ]
    },
    {
      "id": "s_overlap",
      "name": "Press while the valve is open",
      "seed": 3,
      "duration_ms": 5000,
      "digital": [
        {"pin": "D6", "initial": 1, "events": [
          {"t_ms": 1000, "value": 0},
          {"t_ms": 1080, "value": 1},
          {"t_ms": 1250, "value": 0},
          {"t_ms": 1330, "value": 1}
        ]}
      ]
    },
    {
      "id": "s_wrap",
      "name": "Presses around the 32-bit millis rollover",
      "seed": 4,
      "duration_ms": 6000,
      "start_millis": 4294965296,
      "digital": [
        {"pin": "D6", "initial": 1, "events": [
          {"t_ms": 1000, "value": 0},
          {"t_ms": 1150, "value": 1},
          {"t_ms": 1600, "value": 0},
          {"t_ms": 1750, "value": 1},
          {"t_ms": 3200, "value": 0},
          {"t_ms": 3350, "value": 1}
        ]}
      ]
    }
  ]
}
