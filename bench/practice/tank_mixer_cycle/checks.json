{
  "assertions": [
    {
      "id": "a_start",
      "type": "serial_period",
      "pattern": "^mix \\d+$",
      "period_ms": 5000,
      "tolerance_ms": 250,
      "description": "A run starts every 5 s",
      "covers": "Print `mix <n>` when each run starts, once per 5000 ms ±250 ms."
    },
    {
      "id": "a_rate",
      "type": "max_toggles",
      "pin": "D6",
      "max_toggles": 2,
      "window_ms": 5000,
      "description": "Mixer switching rate",
      "covers": "The mixer must not change state more than 2 times in any 5000 ms window."
    },
    {
      "id": "a_hold",
      "type": "output_follows",
      "pin": "D6",
      "low_when": {"pin": "D3", "op": "==", "value": 0},
      "within_ms": 300,
      "mode": "level",
      "description": "Hold switch keeps the mixer off",
      "covers": "While D3 is held LOW, keep D6 LOW. The runs are still counted and printed."
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_fresh",
      "name": "Normal schedule after power-on",
      "seed": 1,
      "duration_ms": 15000,
      "digital": [
        {"pin": "D3", "initial": 1, "events": []}
      ]
    },
    {
      "id": "s_hold",
      "name": "Hold switch pressed during a run",
      "seed": 2,
      "duration_ms": 15000,
      "digital": [
        {"pin": "D3", "initial": 1, "events": [
          {"t_ms": 5500, "value": 0},
          {"t_ms": 7500, "value": 1}
        ]}
      ]
    },
    {
      "id": "s_minute",
      "name": "Schedule across a 16-bit clock wrap",
      "seed": 3,
      "duration_ms": 15000,
      "start_millis": 193108,
      "digital": [
        {"pin": "D3", "initial": 1, "events": []}
      ]
    },
    {
      "id": "s_long_uptime",
      "name": "Schedule after an uptime that is a multiple of the wrap",
      "seed": 4,
      "duration_ms": 15000,
      "start_millis": 5000000,
      "digital": [
        {"pin": "D3", "initial": 1, "events": []}
      ]
    }
  ]
}
