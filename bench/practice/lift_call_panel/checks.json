{
  "assertions": [
    {
      "id": "a_buzz",
      "type": "timed_pulse",
      "pin": "D11",
      "trigger": {"pin": "D5", "op": "==", "value": 0},
      "duration_ms": 300,
      "tolerance_ms": 80,
      "within_ms": 100,
      "min_trigger_ms": 30,
      "active_level": 1,
      "during_pulse": "ignore",
      "description": "A press sounds the buzzer for 300 ms",
      "covers": "A settled press on D5 sounds the buzzer: D11 HIGH for 300 ms, starting within 100 ms of the press."
    },
    {
      "id": "a_beat",
      "type": "serial_period",
      "pattern": "^alive \\d+$",
      "period_ms": 500,
      "tolerance_ms": 120,
      "description": "Heartbeat every 500 ms",
      "covers": "Print `alive <n>` every 500 ms ±120 ms, with n counting the lines printed."
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_quiet",
      "name": "No presses",
      "seed": 1,
      "duration_ms": 4000,
      "digital": [
        {"pin": "D5", "initial": 1, "events": []}
      ]
    },
    {
      "id": "s_early",
      "name": "Press right after a heartbeat",
      "seed": 2,
      "duration_ms": 5000,
      "digital": [
        {"pin": "D5", "initial": 1, "events": [
          {"t_ms": 1020, "value": 0, "bounce_ms": 6, "bounce_count": 3},
          {"t_ms": 1120, "value": 1, "bounce_ms": 6, "bounce_count": 3}
        ]}
      ]
    },
    {
      "id": "s_ignored",
      "name": "Second press while the buzzer sounds",
      "seed": 3,
      "duration_ms": 5000,
      "digital": [
        {"pin": "D5", "initial": 1, "events": [
          {"t_ms": 1020, "value": 0},
          {"t_ms": 1100, "value": 1},
          {"t_ms": 1200, "value": 0},
          {"t_ms": 1280, "value": 1}
        ]}
      ]
    },
    {
      "id": "s_late",
      "name": "Press just before a heartbeat",
      "seed": 4,
      "duration_ms": 6000,
      "digital": [
        {"pin": "D5", "initial": 1, "events": [
          {"t_ms": 1400, "value": 0},
          {"t_ms": 1500, "value": 1},
          {"t_ms": 3350, "value": 0},
          {"t_ms": 3450, "value": 1}
        ]}
      ]
    }
  ]
}
