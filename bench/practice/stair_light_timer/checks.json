{
  "assertions": [
    {
      "id": "a_light",
      "type": "timed_pulse",
      "pin": "D9",
      "trigger": {"pin": "D2", "op": "==", "value": 0},
      "duration_ms": 3000,
      "tolerance_ms": 250,
      "within_ms": 100,
      "min_trigger_ms": 30,
      "active_level": 1,
      "during_pulse": "ignore",
      "description": "A press lights the stairs for 3 s",
      "covers": "A settled press on D2 turns D9 HIGH for 3000 ms, starting within 100 ms of the press."
    },
    {
      "id": "a_mode",
      "type": "max_toggles",
      "pin": "D9",
      "max_toggles": 0,
      "window_ms": 5000,
      "description": "The mode switch alone never moves the light",
      "covers": "Changing D3 has no effect on D9, whether the light is on or off."
    },
    {
      "id": "a_status",
      "type": "serial_period",
      "pattern": "^stair mode=[01] lit=[01]$",
      "period_ms": 1000,
      "tolerance_ms": 150,
      "description": "Status line once per second",
      "covers": "Print `stair mode=<0|1> lit=<0|1>` every 1000 ms, where mode is the level of D3."
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_press",
      "name": "One press",
      "seed": 1,
      "duration_ms": 7000,
      "digital": [
        {"pin": "D2", "initial": 1, "events": [
          {"t_ms": 1000, "value": 0},
          {"t_ms": 1150, "value": 1}
        ]},
        {"pin": "D3", "initial": 1, "events": []}
      ]
    },
    {
      "id": "s_ignore",
      "name": "Second press while the light is on",
      "seed": 2,
      "duration_ms": 8000,
      "digital": [
        {"pin": "D2", "initial": 1, "events": [
          {"t_ms": 1000, "value": 0},
          {"t_ms": 1100, "value": 1},
          {"t_ms": 2000, "value": 0},
          {"t_ms": 2100, "value": 1}
        ]},
        {"pin": "D3", "initial": 1, "events": []}
      ]
    },
    {
      "id": "s_mode_idle",
      "name": "Mode switch changed with the light off",
      "seed": 3,
      "duration_ms": 5000,
      "digital": [
        {"pin": "D2", "initial": 1, "events": []},
        {"pin": "D3", "initial": 1, "events": [
          {"t_ms": 1500, "value": 0},
          {"t_ms": 2500, "value": 1},
          {"t_ms": 3500, "value": 0}
        ]}
      ]
    },
    {
      "id": "s_mode_mid",
      "name": "Mode switch changed while the light is on",
      "seed": 4,
      "duration_ms": 10000,
      "digital": [
        {"pin": "D2", "initial": 1, "events": [
          {"t_ms": 1000, "value": 0},
          {"t_ms": 1100, "value": 1}
        ]},
        {"pin": "D3", "initial": 1, "events": [
          {"t_ms": 2000, "value": 0},
          {"t_ms": 2600, "value": 1}
        ]}
      ]
    }
  ]
}
