{
  "assertions": [
    {
      "id": "a_level",
      "type": "serial_value_matches",
      "pattern": "^level (-?\\d+) mm$",
      "input_pin": "A2",
      "tolerance": 40,
      "max_lag_ms": 1500,
      "description": "Printed level tracks the probe",
      "covers": "Print `level <mm> mm` every 1000 ms; the printed level must stay within ±40 mm of the injected level."
    },
    {
      "id": "a_lamp",
      "type": "output_follows",
      "pin": "D6",
      "high_when": {"pin": "A2", "op": ">=", "value": 4200},
      "low_when": {"pin": "A2", "op": "<", "value": 4200},
      "within_ms": 1500,
      "mode": "level",
      "description": "Lamp at 4200 mm",
      "covers": "Drive D6 HIGH when the averaged level is at or above 4200 mm; otherwise LOW, within 1500 ms."
    },
    {
      "id": "a_no_crash",
      "type": "no_crash",
      "description": "Firmware must not crash"
    }
  ],
  "scenarios": [
    {
      "id": "s_mid",
      "name": "Half-full silo",
      "seed": 1,
      "duration_ms": 6000,
      "analog": [
        {"pin": "A2", "segments": [{"t_ms": 0, "mv": 2500}], "noise_mv": 0, "spikes": []}
      ]
    },
    {
      "id": "s_high_normal",
      "name": "High but under the lamp level",
      "seed": 2,
      "duration_ms": 6000,
      "analog": [
        {"pin": "A2", "segments": [{"t_ms": 0, "mv": 3800}], "noise_mv": 5, "spikes": []}
      ]
    },
    {
      "id": "s_full",
      "name": "Full silo",
      "seed": 3,
      "duration_ms": 6000,
      "analog": [
        {"pin": "A2", "segments": [{"t_ms": 0, "mv": 4600}], "noise_mv": 5, "spikes": []}
      ]
    },
    {
      "id": "s_top",
      "name": "Probe at the top of its range",
      "seed": 4,
      "duration_ms": 6000,
      "analog": [
        {"pin": "A2", "segments": [{"t_ms": 0, "mv": 4800}], "noise_mv": 0, "spikes": []}
      ]
    }
  ]
}
