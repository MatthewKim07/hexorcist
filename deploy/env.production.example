# Copy to .env in the repo root, chmod 600, and fill in. Never commit it.

# Vultr Serverless Inference.
LLM_BASE_URL=https://api.vultrinference.com/v1
LLM_API_KEY=
# Run deploy/list-models.sh after setting the key, then paste an id here.
LLM_MODEL=

# Required. Anyone starting a run must send this. Generate one with: openssl rand -base64 18
DEMO_PASSCODE=

# Required. Certificate notices, and it turns on Caddy's ZeroSSL failover.
ACME_EMAIL=

# Runs per IP address per hour, and concurrent runs. Keep the rate limit above 0.
RATE_LIMIT_PER_HOUR=20
MAX_ACTIVE_RUNS=3
