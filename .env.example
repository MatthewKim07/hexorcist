# Any OpenAI-compatible endpoint. Nothing in the code is provider specific.

# Vultr Serverless Inference, required for agent LLM calls in the hackathon submission.
# Pick LLM_MODEL from the models your Vultr inference subscription lists.
# LLM_BASE_URL=https://api.vultrinference.com/v1
# LLM_API_KEY=
# LLM_MODEL=

# DeepSeek, for development.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# OpenAI, for development.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Set this on a public demo. Starting a run then needs the passcode, sent as X-Demo-Passcode.
DEMO_PASSCODE=

# Optional. Defaults shown.
# HEXORCIST_PORT=8080
# RATE_LIMIT_PER_HOUR=20
# MAX_ACTIVE_RUNS=3
