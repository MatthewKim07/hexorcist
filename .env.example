# Any OpenAI-compatible endpoint. Nothing in the code is provider specific.

# Vultr Serverless Inference, required for agent LLM calls in the hackathon submission.
# Pick LLM_MODEL from the models your Vultr inference subscription lists.
# LLM_BASE_URL=https://api.vultrinference.com/v1
# LLM_API_KEY=
# LLM_MODEL=

# DeepSeek, for development.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# OpenAI, for development.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Optional second model. It writes clean room 2 in the agent (a different model from LLM_*, so the two clean rooms make
# less correlated mistakes) and is the second baseline and match judge in bench/. Leave the key empty to use LLM_* for both rooms.
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Model for the strong plain-review baseline (bench.run_baseline --endpoint strong), on the same OpenAI account. Empty means off.
# Reasoning models (o3, gpt-5) need --max-tokens 16000.
BASELINE_STRONG_MODEL=

# Set this on a public demo. Starting a run then needs the passcode, sent as X-Demo-Passcode.
DEMO_PASSCODE=

# Optional. Defaults shown.
# HEXORCIST_PORT=8080
# RATE_LIMIT_PER_HOUR=20
# MAX_ACTIVE_RUNS=3

# Break-mode agent steps (defaults shown).
# CLEANROOM=1            implementations written from the spec alone, to tell bugs from checks no correct firmware passes
# CLEANROOM_SAMPLES=2    independent clean-room sketches (1 or 2). A check is dropped only if every one of them fails it
# CLEANROOM_MIXED=1      room 2 is written by the OPENAI_* model when a key is set. 0 keeps both rooms on LLM_*
# SEARCH_VARIANTS=0      scenario variants tried on the uploaded firmware. 0 (default) = stimulus search off. It keeps a finding only
#                        if it fails on your sketch, passes on both clean rooms in the same variant, and stays inside the spec's ranges
# SEARCH_SEED=1337       fixed seed, so the same run makes the same variants
# SEARCH_BUDGET_S=90     stop starting new search runs after this many seconds
